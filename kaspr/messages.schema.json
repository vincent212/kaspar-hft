      "custom_cpp_type": "kasprowy::msg::DataBar",
      "custom_cpp_includes": ["kasprowy_messages.hpp"],
      "custom_cpp_deserializer": "auto* m = new kasprowy::msg::DataBar(); m->timestamp = j[\"timestamp\"].get<int64_t>(); m->date = j[\"date\"].get<std::string>(); m->time = j[\"time\"].get<std::string>(); m->vix_open = j[\"vix_open\"].get<double>(); m->vix_high = j[\"vix_high\"].get<double>(); m->vix_low = j[\"vix_low\"].get<double>(); m->vix_close = j[\"vix_close\"].get<double>(); m->spx_open = j[\"spx_open\"].get<double>(); m->spx_high = j[\"spx_high\"].get<double>(); m->spx_low = j[\"spx_low\"].get<double>(); m->spx_close = j[\"spx_close\"].get<double>(); if (j.contains(\"prev_vix_close\") && !j[\"prev_vix_close\"].is_null()) { m->prev_vix_close = j[\"prev_vix_close\"].get<double>(); } return m;",
      "fields": [
        {
          "name": "timestamp",
          "type": "int64",
          "description": "Unix timestamp in milliseconds"
        },
        {
          "name": "date",
          "type": "string",
          "description": "Date in YYYY-MM-DD format"
        },
        {
          "name": "time",
          "type": "string",
          "description": "Time in HH:MM:SS format"
        },
        {
          "name": "vix_open",
          "type": "float64",
          "description": "VIX open price"
        },
        {
          "name": "vix_high",
          "type": "float64",
          "description": "VIX high price"
        },
        {
          "name": "vix_low",
          "type": "float64",
          "description": "VIX low price"
        },
        {
          "name": "vix_close",
          "type": "float64",
          "description": "VIX close price"
        },
        {
          "name": "spx_open",
          "type": "float64",
          "description": "SPX open price"
        },
        {
          "name": "spx_high",
          "type": "float64",
          "description": "SPX high price"
        },
        {
          "name": "spx_low",
          "type": "float64",
          "description": "SPX low price"
        },
        {
          "name": "spx_close",
          "type": "float64",
          "description": "SPX close price"
        }
      ]
