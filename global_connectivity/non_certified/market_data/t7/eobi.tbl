SecurityID SInt 6 8 # instrument whose book is cleared (ofs 8)
TransactTime UTCTimestamp 14 8 # transaction time (ofs 16)

MessageType 13105 0 2 # PartialOrderExecution: resting visible order partly executed; remaining = book quantity - LastQty (p.67-68, 8.4; p.16, 4.6)
@size 54
MsgSeqNum UInt 2 4 # per product (ofs 4)
Side UInt 6 1 # 1 buy, 2 sell; side of the resting order (ofs 8)
OrdType UInt 7 1 # 1 market order; cash only (ofs 9)
AlgorithmicTradeIndicator UInt 8 1 # 1 algorithmic; cash only (ofs 10)
HHIIndicator SInt 9 1 # HHI; -1 no update (ofs 11)
TrdMatchID UInt 10 4 # match step id, always set (ofs 12)
Price PriceType 14 8 # price at which the order entered the book (key level) (ofs 16)
TrdRegTSTimePriority UTCTimestamp 22 8 # priority timestamp (key) (ofs 24)
SecurityID SInt 30 8 # instrument (ofs 32)
LastQty QuantityType 38 8 # executed quantity (ofs 40)
LastPx PriceType 46 8 # execution price; differs from Price in uncrossing (ofs 48)

MessageType 13104 0 2 # FullOrderExecution: resting visible order fully executed; remove it (p.69-70, 8.4; p.16, 4.6)
@size 54
MsgSeqNum UInt 2 4 # per product (ofs 4)
Side UInt 6 1 # 1 buy, 2 sell; side of the resting order (ofs 8)
OrdType UInt 7 1 # 1 market order; cash only (ofs 9)
AlgorithmicTradeIndicator UInt 8 1 # 1 algorithmic; cash only (ofs 10)
HHIIndicator SInt 9 1 # HHI if the level still exists; -1 no update (ofs 11)
TrdMatchID UInt 10 4 # match step id, always set (ofs 12)
Price PriceType 14 8 # price at which the order entered the book (key level) (ofs 16)
TrdRegTSTimePriority UTCTimestamp 22 8 # priority timestamp (key) (ofs 24)
SecurityID SInt 30 8 # instrument (ofs 32)
LastQty QuantityType 38 8 # executed quantity (ofs 40)
LastPx PriceType 46 8 # execution price; differs from Price in uncrossing (ofs 48)

MessageType 13500 0 2 # AuctionBestBidOffer: BBO of an uncrossed book during an auction (p.71-72, 8.4; p.18, 4.8)
@size 62
MsgSeqNum UInt 2 4 # per product (ofs 4)
TransactTime UTCTimestamp 6 8 # timestamp of the book entry (ofs 8)
SecurityID SInt 14 8 # instrument (ofs 16)
BidPx PriceType 22 8 # bid price, optional (ofs 24)
OfferPx PriceType 30 8 # offer price, optional (ofs 32)
BidSize QuantityType 38 8 # cash only (ofs 40)
OfferSize QuantityType 46 8 # cash only (ofs 48)
PotentialSecurityTradingEvent UInt 54 1 # 0 none; cash only (ofs 56)
BidOrdType UInt 55 1 # 1 market orders on the bid when BidPx is empty; cash only (ofs 57)
OfferOrdType UInt 56 1 # 1 market orders on the offer when OfferPx is empty; cash only (ofs 58)
Pad5 Pad 57 5 # not used (ofs 59)

MessageType 13501 0 2 # AuctionClearingPrice: potential auction price of a crossed book (p.73-74, 8.4; p.18, 4.8)
@size 54
MsgSeqNum UInt 2 4 # per product (ofs 4)
TransactTime UTCTimestamp 6 8 # transaction time (ofs 8)
SecurityID SInt 14 8 # instrument (ofs 16)
