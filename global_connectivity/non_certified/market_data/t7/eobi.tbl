# Field table: Deutsche Boerse T7 Enhanced Order Book Interface (EOBI), Release 15.0.
#
# Source: "T7 Release 15.0, Enhanced Order Book Interface, Manual", Version 1,
# build 150.522.2.ga-150005020-91, 29 July 2026 (public). Cited below as
# (p.N, section). Cross-checked against "T7 R.15.0 EOBI XML Representation
# Version 1" (eobi.xml, EOBILayouts.h, same build number).
#
# Every integer is little endian (p.36, 7.4 Table 6; p.10, 3.2).
# PriceType: signed 8-byte integer, 8 implied decimals. QuantityType: signed
# 8-byte integer, 4 implied decimals. UTCTimestamp: unsigned 8-byte ns since
# the UNIX epoch, UTC (p.36, 7.4; p.26, 5). No-value sentinels (p.36, 7.4):
# signed ints the minimum (0x80, 0x8000, 0x80000000, 0x8000000000000000),
# unsigned ints all bits set, Fixed String 0x00 in the first byte.
#
# Framing (p.30, 7.1; p.40, 8.2): a UDP datagram is a Packet Header followed by
# messages. Packet Header and every message begin with the MessageHeader:
# BodyLen (2 bytes, the whole message, including BodyLen itself), TemplateID
# (2 bytes), MsgSeqNum (4 bytes). BodyLen is the @length_prefix here, so every
# offset below is the manual's Ofs minus 2 and every @size the manual's
# message length minus 2; "ofs N" in a description is the manual's offset.
#
# Repeating groups (TradeReversal, MassInstrumentStateChange,
# AddComplexInstrument, InstrumentSummary) are variable size arrays at the end
# of the message, with a counter in the fixed part. The fixed part is modelled
# in eobi::from_t7 with the array as a trailing variable-length field; one
# entry of each array is the untyped struct of the same name in grp::from_t7.
@venue t7
@endian little
@pad nul
@type UInt uint
@type SInt int
@type Counter uint
@type PriceType int
@type QuantityType int
@type UTCTimestamp uint
@type FixedString char
@type Pad bytes
@type Group bytes

### pkt::from_t7
# Typed rather than untyped: the TemplateID of the Packet Header identifies
# the interface release (13002 in R15.0; up to five values reserved, p.40,
# 8.2), so a datagram from another release decodes as `unknown` instead of
# being read with the wrong layout.
@length_prefix 2 inclusive
@type_code uint 2

MessageType 13002 0 2 # PacketHeader: start of every datagram; MarketDataReport U20 (p.40-41, 8.2)
@size 30
MsgSeqNum UInt 2 4 # not used; always 0xFFFFFFFF (p.23, 4.16) (ofs 4)
ApplSeqNum UInt 6 4 # packet sequence number, contiguous per channel across products (ofs 8)
MarketSegmentID SInt 10 4 # product identifier; one product per datagram (ofs 12)
PartitionID UInt 14 1 # grouping of T7 products; even: service A sent first, odd: B first (p.10, 3.2) (ofs 16)
CompletionIndicator UInt 15 1 # 0 Incomplete, 1 Complete: unit of work (incremental) or product snapshot (snapshot) ends here (ofs 17)
ApplSeqResetIndicator UInt 16 1 # 0 No Reset, 1 Reset; set in the first packets after a (re)start (ofs 18)
DSCP UInt 17 1 # copy of DSCP from the IP header, A.5 (ofs 19)
Pad4 Pad 18 4 # not used (ofs 20)
TransactTime UTCTimestamp 22 8 # time the feed handler put the packet on the wire (t_9) (ofs 24)

### eobi::from_t7
@length_prefix 2 inclusive
@type_code uint 2

MessageType 13001 0 2 # Heartbeat: functional heartbeat per quiet product, incremental channel (p.42, 8.2)
@size 14
MsgSeqNum UInt 2 4 # not used (ofs 4)
LastMsgSeqNumProcessed UInt 6 4 # last MsgSeqNum sent for the product; 0 before Start-Of-Day (p.32, 7.2) (ofs 8)
Pad4 Pad 10 4 # not used (ofs 12)

MessageType 13202 0 2 # ExecutionSummary: one per match event triggered by an incoming order; not sent for matches without one (p.43-45, 8.3; p.17, 4.6)
@size 102
MsgSeqNum UInt 2 4 # per product across all message types (ofs 4)
SecurityID SInt 6 8 # instrument of the incoming order (ofs 8)
RequestTime UTCTimestamp 14 8 # gateway-in time (t_3n/t_3), optional (ofs 16)
ExecID UTCTimestamp 22 8 # matching timestamp (t_7) (ofs 24)
LastQty QuantityType 30 8 # total executed quantity of the match event (ofs 32)
AggressorSide UInt 38 1 # 1 buy, 2 sell; empty for Continuous Auction Issuer (ofs 40)
Pad1 Pad 39 1 # not used (ofs 41)
TradeCondition UInt 40 2 # 1 Implied Trade (synthetic match) (ofs 42)
TradingHHIIndicator UInt 42 1 # HHI interval index of the match event, optional (ofs 44)
Pad3 Pad 43 3 # not used (ofs 45)
LastPx PriceType 46 8 # worst price of the match (ofs 48)
TrdRegTSPrevTimePriority UTCTimestamp 54 8 # RemainingOrderDetails: previous priority timestamp of the aggressor (ofs 56)
DisplayQty QuantityType 62 8 # RemainingOrderDetails: remaining quantity to be added, else empty (ofs 64)
Price PriceType 70 8 # RemainingOrderDetails: limit price of the remainder; empty for a disclosed market order (ofs 72)
RestingHiddenQty QuantityType 78 8 # executed or cancelled passive quantity not displayed; empty if TradeCondition = 1 (ofs 80)
RestingCxlQty QuantityType 86 8 # quantity cancelled by SMP in this match event, not part of LastQty (ofs 88)
AggressorTime UTCTimestamp 94 8 # matching-engine-in time (t_5), optional (ofs 96)

MessageType 13503 0 2 # QuoteRequest: request for quote, incremental only (p.46, 8.3)
@size 38
MsgSeqNum UInt 2 4 # per product (ofs 4)
SecurityID SInt 6 8 # instrument (ofs 8)
LastQty QuantityType 14 8 # requested quantity, optional (ofs 16)
Side UInt 22 1 # 1 buy, 2 sell, optional (ofs 24)
Pad7 Pad 23 7 # not used (ofs 25)
TransactTime UTCTimestamp 30 8 # transaction time (ofs 32)

MessageType 13502 0 2 # CrossRequest: cross announcement or liquidity improvement cross, incremental only (p.47-48, 8.3)
@size 46
MsgSeqNum UInt 2 4 # per product (ofs 4)
SecurityID SInt 6 8 # instrument (ofs 8)
LastPx PriceType 14 8 # price of a Liquidity Improvement Cross, optional (ofs 16)
LastQty QuantityType 22 8 # requested quantity, optional (ofs 24)
Side UInt 30 1 # 1 buy, 2 sell, optional (ofs 32)
CrossRequestType UInt 31 1 # 1 Cross Announcement, 2 Liquidity Improvement Cross (ofs 33)
InputSource UInt 32 1 # 1 CLIP client broker, optional (ofs 34)
Pad5 Pad 33 5 # not used (ofs 35)
TransactTime UTCTimestamp 38 8 # transaction time (ofs 40)

MessageType 13201 0 2 # TradeReport: auction, Xetra retail, manual entry, reference price and price without turnover (LastQty 0) (p.49-51, 8.3; p.21, 4.13)
@size 54
MsgSeqNum UInt 2 4 # per product (ofs 4)
SecurityID SInt 6 8 # instrument (ofs 8)
TransactTime UTCTimestamp 14 8 # transaction time (ofs 16)
LastQty QuantityType 22 8 # quantity; 0 for reference price and (auction) price without turnover (ofs 24)
LastPx PriceType 30 8 # price (ofs 32)
TrdMatchID UInt 38 4 # match step id, product-wide day-unique; not set for reference price (ofs 40)
MatchType UInt 42 1 # 3 manual, 5 uncrossing, 7 auction, 13 LIC, 14 PWT in continuous auction (ofs 44)
MatchSubType UInt 43 1 # 1 opening, 2 closing, 3 intraday, 4 circuit breaker, 5 IPO, 6 retail auction (ofs 45)
AlgorithmicTradeIndicator UInt 44 1 # 1 algorithmic trade; cash markets only (ofs 46)
Pad1 Pad 45 1 # not used (ofs 47)
TradeCondition UInt 46 2 # 107 k, 155 BB, 156 BC, 206 DA, 596 SA, 624 TC, 743 XR (ofs 48)
Pad6 Pad 48 6 # not used (ofs 50)

MessageType 13200 0 2 # TradeReversal: full reversal of a previously reported trade by Market Supervision; NoMDEntries MDTradeEntry follow (p.52-53, 8.3; p.21, 4.12)
@size 54
MsgSeqNum UInt 2 4 # per product (ofs 4)
SecurityID SInt 6 8 # instrument (ofs 8)
TransactTime UTCTimestamp 14 8 # time the reversal was processed (ofs 16)
LastQty QuantityType 22 8 # quantity of the reversed trade (ofs 24)
LastPx PriceType 30 8 # price of the reversed trade (ofs 32)
TrdRegTSExecutionTime UTCTimestamp 38 8 # matching timestamp of the new last trade, optional (ofs 40)
TrdMatchID UInt 46 4 # match step id of the reversed trade (ofs 48)
TradeCondition UInt 50 2 # 155 BB, 206 DA, 624 TC, 743 XR; cash markets only (ofs 52)
MDOriginType UInt 52 1 # 0 Book, 1 Off Book (ofs 54)
NoMDEntries Counter 53 1 # entries in MDTradeEntryGrp, 0..18 (ofs 55)
MDTradeEntryGrp Group 54 # NoMDEntries x grp::MDTradeEntry (24 bytes each) (ofs 56)

MessageType 13203 0 2 # TESTradeReport: off-book (T7 Entry Service) trade and volume (p.54-55, 8.3; p.20, 4.11)
@size 78
MsgSeqNum UInt 2 4 # per product (ofs 4)
SecurityID SInt 6 8 # instrument (ofs 8)
TransactTime UTCTimestamp 14 8 # transaction time (ofs 16)
LastQty QuantityType 22 8 # quantity, optional (ofs 24)
LastPx PriceType 30 8 # price, optional (ofs 32)
TrdMatchID UInt 38 4 # match step id, optional (ofs 40)
TrdType UInt 42 2 # 1 block, 2 EFP, 54 OTC, 55 EBF, 1000 vola, 1001, 1002, 1004, 1006, 1007 (ofs 44)
TradeCondition UInt 44 2 # 107 out of sequence (basket) (ofs 46)
MultiLegReportingType UInt 46 1 # 1 single security, 2 leg of a multi-leg security (ofs 48)
MultiLegPriceModel UInt 47 1 # 0 standard, 1 user defined (ofs 49)
Pad6 Pad 48 6 # not used (ofs 50)
NonDisclosedTradeVolume QuantityType 54 8 # only while TESTradSesStatus = 5 Pre Close (ofs 56)
TransBkdTime UTCTimestamp 62 8 # time of the original trade in an external system (ofs 64)
NumberOfBuySides UInt 70 2 # buy sides of the TES trade (ofs 72)
NumberOfSellSides UInt 72 2 # sell sides of the TES trade (ofs 74)
Pad4 Pad 74 4 # not used (ofs 76)

MessageType 13100 0 2 # OrderAdd: visible order or quote side added; key SecurityID+Side+TrdRegTSTimePriority (p.56-57, 8.4; p.15, 4.2)
@size 54
MsgSeqNum UInt 2 4 # per product (ofs 4)
RequestTime UTCTimestamp 6 8 # gateway-in time; not set for self-triggered transactions (ofs 8)
SecurityID SInt 14 8 # instrument (ofs 16)
TrdRegTSTimePriority UTCTimestamp 22 8 # OrderDetails: priority timestamp (ofs 24)
DisplayQty QuantityType 30 8 # OrderDetails: displayed quantity (ofs 32)
Side UInt 38 1 # OrderDetails: 1 buy, 2 sell (ofs 40)
OrdType UInt 39 1 # OrderDetails: 1 market order; cash markets only (ofs 41)
HHIIndicator SInt 40 1 # OrderDetails: HHI interval at the price level; -1 no update (ofs 42)
Pad5 Pad 41 5 # OrderDetails: not used (ofs 43)
Price PriceType 46 8 # OrderDetails: price; optional (ofs 48)

MessageType 13504 0 2 # TopOfBook: BBO; derivatives post trading to end of day, cash during Trade At Close (p.58, 8.4)
@size 62
MsgSeqNum UInt 2 4 # per product (ofs 4)
TransactTime UTCTimestamp 6 8 # transaction time (ofs 8)
SecurityID SInt 14 8 # instrument (ofs 16)
BidPx PriceType 22 8 # bid price, optional (ofs 24)
OfferPx PriceType 30 8 # offer price, optional (ofs 32)
BidSize QuantityType 38 8 # bid quantity, optional (ofs 40)
OfferSize QuantityType 46 8 # offer quantity, optional (ofs 48)
NumberOfBuyOrders UInt 54 2 # only in Trade At Close (ofs 56)
NumberOfSellOrders UInt 56 2 # only in Trade At Close (ofs 58)
Pad4 Pad 58 4 # not used (ofs 60)

MessageType 13101 0 2 # OrderModify: order modified with a new priority timestamp; old key in TrdRegTSPrevTimePriority (p.59-61, 8.4; p.16, 4.4)
@size 86
MsgSeqNum UInt 2 4 # per product (ofs 4)
RequestTime UTCTimestamp 6 8 # gateway-in time (ofs 8)
TrdRegTSPrevTimePriority UTCTimestamp 14 8 # previous priority timestamp (old key) (ofs 16)
PrevPrice PriceType 22 8 # previous price, optional (ofs 24)
PrevDisplayQty QuantityType 30 8 # previous displayed quantity (ofs 32)
SecurityID SInt 38 8 # instrument (ofs 40)
TrdRegTSTimePriority UTCTimestamp 46 8 # OrderDetails: new priority timestamp (new key) (ofs 48)
DisplayQty QuantityType 54 8 # OrderDetails: new displayed quantity (ofs 56)
Side UInt 62 1 # OrderDetails: 1 buy, 2 sell (ofs 64)
OrdType UInt 63 1 # OrderDetails: 1 market order; cash only (ofs 65)
HHIIndicator SInt 64 1 # OrderDetails: HHI at the new price level; -1 no update (ofs 66)
Pad5 Pad 65 5 # OrderDetails: not used (ofs 67)
Price PriceType 70 8 # OrderDetails: new price, optional (ofs 72)
PrevPriceHHIIndicator SInt 78 1 # HHI at the previous price level if it still exists (ofs 80)
Pad7 Pad 79 7 # not used (ofs 81)

MessageType 13106 0 2 # OrderModifySamePriority: order modified without loss of priority, e.g. quantity reduced (p.62-63, 8.4; p.16, 4.4)
@size 70
MsgSeqNum UInt 2 4 # per product (ofs 4)
RequestTime UTCTimestamp 6 8 # gateway-in time, optional (ofs 8)
TransactTime UTCTimestamp 14 8 # transaction time (ofs 16)
PrevDisplayQty QuantityType 22 8 # previous displayed quantity (ofs 24)
SecurityID SInt 30 8 # instrument (ofs 32)
TrdRegTSTimePriority UTCTimestamp 38 8 # OrderDetails: unchanged priority timestamp (key) (ofs 40)
DisplayQty QuantityType 46 8 # OrderDetails: new displayed quantity (ofs 48)
Side UInt 54 1 # OrderDetails: 1 buy, 2 sell (ofs 56)
OrdType UInt 55 1 # OrderDetails: 1 market order; cash only (ofs 57)
HHIIndicator SInt 56 1 # OrderDetails: HHI; -1 no update (ofs 58)
Pad5 Pad 57 5 # OrderDetails: not used (ofs 59)
