MessageType 13602 0 2 # SnapshotOrder: one visible order; instrument from the preceding InstrumentSummary (p.105, 8.7)
@size 38
MsgSeqNum UInt 2 4 # per snapshot cycle per channel (ofs 4)
TrdRegTSTimePriority UTCTimestamp 6 8 # OrderDetails: priority timestamp (key) (ofs 8)
DisplayQty QuantityType 14 8 # OrderDetails: displayed quantity (ofs 16)
Side UInt 22 1 # OrderDetails: 1 buy, 2 sell (ofs 24)
OrdType UInt 23 1 # OrderDetails: 1 market order; cash only (ofs 25)
HHIIndicator SInt 24 1 # OrderDetails: HHI index > 0; -1 no update (ofs 26)
Pad5 Pad 25 5 # OrderDetails: not used (ofs 27)
Price PriceType 30 8 # OrderDetails: price, optional (ofs 32)

### grp::from_t7
# One entry of each variable size array. Offsets are from the start of the
# entry; the manual's offsets are those of the first entry in the message.

MessageType - 0 0 # MDTradeEntry: entry of TradeReversal MDTradeEntryGrp; changed statistics (p.53, 8.3)
@size 24
MDEntryPx PriceType 0 8 # price (ofs 56)
MDEntrySize QuantityType 8 8 # quantity (ofs 64)
MDEntryType UInt 16 1 # 2 trade, 4 opening, 5 closing, 7 high, 8 low (ofs 72)
Pad7 Pad 17 7 # not used (ofs 73)

MessageType - 0 0 # SecMassStat: entry of MassInstrumentStateChange SecMassStatGrp; an exception instrument (p.79-80, 8.5)
@size 32
SecurityID SInt 0 8 # instrument (ofs 32)
HighPx PriceType 8 8 # as InstrumentStateChange (ofs 40)
LowPx PriceType 16 8 # as InstrumentStateChange (ofs 48)
SecurityStatus UInt 24 1 # as InstrumentStateChange (ofs 56)
SecurityTradingStatus UInt 25 1 # as InstrumentStateChange (ofs 57)
MarketCondition UInt 26 1 # 0 normal, 1 stressed (ofs 58)
SecurityTradingEvent UInt 27 1 # 10, 11 (ofs 59)
SoldOutIndicator UInt 28 1 # 1 sold out (ofs 60)
TESSecurityStatus UInt 29 1 # 1, 2, 4, 9 (ofs 61)
Pad2 Pad 30 2 # not used (ofs 62)

MessageType - 0 0 # InstrmtLeg: entry of AddComplexInstrument InstrmtLegGrp (p.90-91, 8.6)
@size 40
LegSymbol SInt 0 4 # product of the leg (ofs 80)
Pad4 Pad 4 4 # not used (ofs 84)
LegSecurityID SInt 8 8 # instrument of the leg (ofs 88)
LegPrice PriceType 16 8 # underlying leg price, optional (ofs 96)
LegRatioQty SInt 24 4 # leg ratio (ofs 104)
LegSecurityType UInt 28 1 # 1 multi-leg, 2 underlying leg (ofs 108)
LegSide UInt 29 1 # 1 buy, 2 sell (ofs 109)
RelatedPriceType UInt 30 1 # 1 basis, 2 custom underlying price (ofs 110)
TradingStyle UInt 31 1 # 1 regular, 2 TRF TAC, 3 TRF TAM, 4 MOC (ofs 111)
RelatedPrice PriceType 32 8 # price given by RelatedPriceType (ofs 112)

MessageType - 0 0 # MDInstrumentEntry: entry of InstrumentSummary MDInstrumentEntryGrp; trade statistics (p.101-103, 8.7)
@size 32
MDEntryPx PriceType 0 8 # price (ofs 64)
MDEntrySize QuantityType 8 8 # quantity (ofs 72)
MDOriginType UInt 16 1 # 0 book, 1 off book (ofs 80)
MDEntryType UInt 17 1 # 2 trade, 4, 5, 7, 8, 66 volume, 101 prev close, 200..205 auctions (ofs 81)
TradeCondition UInt 18 2 # 107, 155, 624, 743 (ofs 82)
TrdType UInt 20 2 # as TESTradeReport (ofs 84)
MultiLegReportingType UInt 22 1 # 1, 2 (ofs 86)
MultiLegPriceModel UInt 23 1 # 0, 1 (ofs 87)
NonDisclosedTradeVolume QuantityType 24 8 # only during TES Pre Close (ofs 88)

### end
