# Field table: Nasdaq GLIMPSE 5.0 (public specification "Nasdaq GLIMPSE",
# Version 5.0, revision of August 22, 2024, which unifies the Nasdaq, BX and PSX
# GLIMPSE specifications). GLIMPSE is a SoupBinTCP service (p.2, Architecture):
# each message is the payload of one SoupBinTCP Sequenced Data packet, so it has
# no length prefix of its own; decode it from the payload soup::from_nasdaq
# returns (tail, tail_len). Offsets are 0-based within the message.
#
# Every message except the End of Snapshot (G) has the TotalView-ITCH 5.0 format
# (p.3); those rows are the ones in itch50.tbl, cited here to the GLIMPSE pages
# where GLIMPSE repeats them.
@venue nasdaq
@endian big
@pad space
@type Integer uint
@type Price4 uint
@type Alpha char
# ASCII digits; the spec does not state the padding. Taken as SoupBinTCP's
# Numeric (left padded with spaces).
@type Numeric char right

### glimpse::from_nasdaq

MessageType S 0 1 # SystemEvent: market or feed handler event (GLIMPSE 5.0, 1.1, p.3)
@size 12
StockLocate Integer 1 2 # Always 0
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
EventCode Alpha 11 1 # O start of messages, S start of system hours, Q start of market hours, M end of market hours, E end of system hours, C end of messages (p.5)

MessageType A 0 1 # AddOrder: new displayed order without MPID attribution (GLIMPSE 5.0, 1.2.1, pp.4-5)
@size 36
StockLocate Integer 1 2 # Locate code identifying the security
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
OrderReferenceNumber Integer 11 8 # Unique for the day
BuySellIndicator Alpha 19 1 # B buy, S sell
Shares Integer 20 4 # Displayed quantity
Stock Alpha 24 8 # Symbol, right-padded with spaces
Price Price4 32 4 # Display price, Price(4)

MessageType F 0 1 # AddOrderMPID: new displayed order with MPID attribution (GLIMPSE 5.0, 1.2.2, p.5)
@size 40
StockLocate Integer 1 2 # Locate code identifying the security
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
OrderReferenceNumber Integer 11 8 # Unique for the day
BuySellIndicator Alpha 19 1 # B buy, S sell
Shares Integer 20 4 # Displayed quantity
Stock Alpha 24 8 # Symbol, right-padded with spaces
Price Price4 32 4 # Display price, Price(4)
Attribution Alpha 36 4 # MPID of the entering participant

MessageType R 0 1 # StockDirectory: one per symbol at the start of the spin (GLIMPSE 5.0, 1.3, pp.5-8)
@size 39
StockLocate Integer 1 2 # Locate code assigned to the symbol for the day
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
Stock Alpha 11 8 # Symbol, right-padded with spaces
MarketCategory Alpha 19 1 # Q G S Nasdaq tiers; N NYSE, A NYSE American, P NYSE Arca, Z BATS Z, V IEX; space not available
FinancialStatusIndicator Alpha 20 1 # D E Q S G H J K C N (Nasdaq-listed); space not available
RoundLotSize Integer 21 4 # Shares in a round lot
RoundLotsOnly Alpha 25 1 # Y only round lots accepted, N no size restriction
IssueClassification Alpha 26 1 # Appendix B (p.14)
IssueSubType Alpha 27 2 # Appendix C (pp.14-16)
Authenticity Alpha 29 1 # P live/production, T test
ShortSaleThresholdIndicator Alpha 30 1 # Y restricted under Rule 203(b)(3), N not, space not available
IPOFlag Alpha 31 1 # Y set up as new IPO, N not, space not available
LULDReferencePriceTier Alpha 32 1 # 1 Tier 1, 2 Tier 2, space not available
ETPFlag Alpha 33 1 # Y ETP, N not, space not available
ETPLeverageFactor Integer 34 4 # Integral leverage of the ETP, rounded down
InverseIndicator Alpha 38 1 # Y inverse ETP, N not

MessageType H 0 1 # StockTradingAction: trading state of a security (GLIMPSE 5.0, 1.4, pp.8-9)
@size 25
StockLocate Integer 1 2 # Locate code identifying the security
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
Stock Alpha 11 8 # Symbol, right-padded with spaces
TradingState Alpha 19 1 # H halted all US markets, P paused (Nasdaq-listed), Q quotation only, T trading on Nasdaq
Reserved Alpha 20 1 # Reserved
Reason Alpha 21 4 # Trading action reason code (ITCH 5.0 Appendix C, pp.32-33)

MessageType Y 0 1 # RegSHORestriction: Reg SHO short sale price test status (GLIMPSE 5.0, 1.5, p.9)
@size 20
LocateCode Integer 1 2 # Locate code identifying the security (the spec names this field Locate Code)
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
Stock Alpha 11 8 # Symbol, right-padded with spaces
RegSHOAction Alpha 19 1 # 0 no price test, 1 restriction in effect (intraday drop), 2 restriction remains in effect

MessageType N 0 1 # RPII: retail price improvement interest (GLIMPSE 5.0, 1.6, pp.9-10; BX only)
@size 20
StockLocate Integer 1 2 # Locate code identifying the security
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
Stock Alpha 11 8 # Symbol, right-padded with spaces
InterestFlag Alpha 19 1 # B buy side, S sell side, A both, N none

MessageType h 0 1 # OperationalHalt: operational halt on one Nasdaq market centre (GLIMPSE 5.0, 1.8, pp.10-11)
@size 21
StockLocate Integer 1 2 # Locate code identifying the security
TrackingNumber Integer 3 2 # Nasdaq internal tracking number
Timestamp Integer 5 6 # Nanoseconds since midnight
Stock Alpha 11 8 # Symbol, right-padded with spaces
MarketCode Alpha 19 1 # Q Nasdaq, B BX, X PSX
OperationalHaltAction Alpha 20 1 # H operationally halted, T halt lifted

MessageType G 0 1 # EndOfSnapshot: last message of the spin; gives the ITCH sequence number to resume at (GLIMPSE 5.0, 1.7, p.10)
@size 21
SequenceNumber Numeric 1 20 # TotalView-ITCH sequence number when the snapshot was taken; process real-time ITCH from this number, ASCII

### end
